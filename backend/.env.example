# Copy to .env and adjust. All values are optional in development.
SECRET_KEY=change-me
# Defaults to backend/instance/sovereign.db
# DATABASE_URL=sqlite:///C:/path/to/sovereign.db
CORS_ORIGINS=http://localhost:5173

# Set DEMO_MODE=false in production: disables the payment simulator,
# the reader lock/unlock toggle, and simulated (unsigned) author events.
DEMO_MODE=true
LIGHTNING_PROVIDER=mock
INVOICE_TTL_SECONDS=600
AUTH_MAX_AGE_SECONDS=120
SEED_ON_START=true

# --- M-Pesa (Safaricom Daraja STK Push) ---
# "mock" works offline with the payment simulator. Use "daraja" with real
# credentials from https://developer.safaricom.co.ke (sandbox or production).
MPESA_PROVIDER=mock
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
# 174379 is the shared Daraja sandbox paybill; use your own shortcode in production.
MPESA_SHORTCODE=174379
MPESA_PASSKEY=
# CustomerPayBillOnline (paybill) or CustomerBuyGoodsOnline (till)
MPESA_TRANSACTION_TYPE=CustomerPayBillOnline
# Must be a public HTTPS URL (use ngrok or similar in development).
MPESA_CALLBACK_URL=https://your-domain.example/api/mpesa/callback?token=change-me
MPESA_CALLBACK_TOKEN=change-me
MPESA_TTL_SECONDS=180
# Chapter prices are set in sats; M-Pesa charges the KES equivalent.
KES_PER_SAT=0.13

# --- Monthly subscriptions (unlock every paid chapter by one author) ---
SUBSCRIPTION_DAYS=30
DEFAULT_SUBSCRIPTION_SATS=3000
